---
import { socialLinks } from '../data/profile';
import { menuItems } from '../data/navigation';
---

<main class="homepage">
	<div class="composition">
		<header class="identity">
			<h1>ClovertaTheTrilobita</h1>
			<p>A.K.A. 三叶</p>
		</header>

		<aside class="profile" aria-label="头像与社交账号">
			<img class="avatar" src="/images/avatar.jpg" alt="三叶的头像：戴着魔女帽的雾雨魔理沙" width="400" height="400" fetchpriority="high" />
			<div class="social-links">
				{socialLinks.map((social) => social.href ? (
					<a class={`social-link ${social.id}`} href={social.href} aria-label={social.label} title={social.label} target="_blank" rel="noopener noreferrer">
						<span class="social-icon" style={`--icon: url('${social.icon}')`} aria-hidden="true"></span>
					</a>
				) : (
					<span class={`social-link ${social.id} unconfigured`} aria-label={`${social.label}（尚未配置账号）`} title={`${social.label} · 尚未配置账号`}>
						<span class="social-icon" style={`--icon: url('${social.icon}')`} aria-hidden="true"></span>
					</span>
				))}
			</div>
		</aside>

		<nav class="navigation" aria-label="主导航">
			{menuItems.map((item) => (
				<a class="menu-item" href={item.href} data-menu={item.id} target={item.id === 'about' ? undefined : '_blank'} rel={item.id === 'about' ? undefined : 'noopener noreferrer'}>
					<span>{item.label}</span><span class="arrow" aria-hidden="true"><span class="arrow-shaft"></span><span class="arrow-head"></span></span>
				</a>
			))}
		</nav>

		<section class="description" aria-label="兴趣与专业">
			<p class="profession">Software Engineering</p>
			<p class="interests">WEB / CODE / LINUX / NONSENSE</p>
		</section>

		<footer class="footer">
			<span class="copyright">Ⓒ ClovertaTheTrilobita</span>
			<div class="registrations">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">赣ICP备2025059789号</a>
				<span class="separator" aria-hidden="true">·</span>
				<a class="security" href="https://beian.mps.gov.cn/#/query/webSearch?code=36020002000597" target="_blank" rel="noopener noreferrer">
					<img src="/images/public-security.png" alt="公安备案标识" width="13" height="14" />
					<span>赣公网安备36020002000597号</span>
				</a>
			</div>
		</footer>
	</div>

</main>

<style>
	.homepage { position: relative; min-height: 100svh; isolation: isolate; overflow: clip; }
	.composition { position: relative; width: 88.8%; max-width: 1500px; min-height: max(700px, 100svh); margin-inline: auto; --avatar-size: clamp(240px, 22.1vw, 340px); }
	.identity { position: absolute; top: 11svh; right: calc(var(--avatar-size) + 32px); text-align: right; }
	h1 { margin: 0; color: #050505; font-family: var(--display-font); font-size: clamp(58px, 6.3vw, 94px); font-weight: 400; line-height: 1; white-space: nowrap; }
	.identity p { margin: 4px 0 0; color: #797979; font: 400 clamp(34px, 3.08vw, 50px)/1.2 var(--display-font); }
	.profile { position: absolute; top: 10svh; right: 0; width: var(--avatar-size); }
	.avatar { display: block; width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; }
	.social-links { display: flex; justify-content: flex-end; align-items: center; gap: 13px; margin-top: 30px; }
	.social-link { display: grid; place-items: center; flex-shrink: 0; width: 34px; height: 34px; color: #858585; transition: color 180ms ease, transform 180ms ease; }
	.social-icon { display: block; width: 100%; height: 100%; background-color: currentColor; mask-image: var(--icon); mask-size: contain; mask-position: center; mask-repeat: no-repeat; }
	a.social-link:hover, a.social-link:focus-visible { color: #2e2e2e; transform: translateY(-3px); }
	.navigation { position: absolute; left: 24px; bottom: 12.2svh; display: flex; flex-direction: column; align-items: flex-start; gap: 27px; }
	.navigation::after { content: ''; position: absolute; left: -24px; bottom: -21px; width: 190px; height: 44px; border-left: 3px solid #575757; border-bottom: 3px solid #575757; pointer-events: none; }
	.menu-item { display: inline-flex; align-items: center; gap: 10px; padding: 0; border: 0; background: none; color: #575757; font: 400 36px/1.3 var(--display-font); cursor: pointer; transform-origin: left center; transition: transform 240ms ease, color 240ms ease; }
	.menu-item:not(.is-returned):hover, .menu-item:not(.is-returned):focus-visible { transform: scale(1.14); color: #454545; }
	.menu-item.is-returned { transition: none; }
	.arrow { display: inline-flex; align-items: center; height: 28px; }
	.arrow-shaft { flex-shrink: 0; width: 13px; height: 4px; background: repeating-linear-gradient(to right, currentColor 0 13px, transparent 13px 18px); border-radius: 4px; transition: width 260ms ease; }
	.arrow-head { flex-shrink: 0; width: 21px; height: 21px; border-top: 4px solid currentColor; border-right: 4px solid currentColor; transform: rotate(45deg); margin-left: 2px; border-radius: 1px; }
	.menu-item:not(.is-returned):hover .arrow-shaft, .menu-item:not(.is-returned):focus-visible .arrow-shaft { width: 67px; }
	.menu-item.is-returned .arrow-shaft { transition: none; }
	.description { position: absolute; left: 51.8%; bottom: 19.4svh; color: #797979; }
	.description p { margin: 0; font-weight: 400; }
	.profession { font-size: clamp(23px, 2.2vw, 35px); line-height: 1.25; text-transform: uppercase; white-space: nowrap; }
	.interests { margin-top: 3px !important; font-size: clamp(17px, 1.61vw, 25px); line-height: 1.3; white-space: nowrap; }
	.footer { position: absolute; left: 51.8%; right: 0; bottom: 9.7svh; display: flex; align-items: center; justify-content: space-between; gap: 20px; color: #282828; font: 400 14px/1.5 'Resource Han Rounded', 'PingFang SC', sans-serif; letter-spacing: .35px; }
	.copyright { flex-shrink: 0; }
	.registrations { display: flex; align-items: center; gap: 10px; white-space: nowrap; }
	.security { display: inline-flex; align-items: center; gap: 3px; }
	.footer a:hover { text-decoration: underline; text-underline-offset: 3px; }

	@media (min-width: 1700px) {
		h1 { font-size: 94px; }
		.footer { font-size: 15px; }
	}
	@media (max-width: 1150px) and (min-width: 761px) {
		.composition { width: 88%; --avatar-size: 24vw; }
		h1 { font-size: 5.4vw; }
		.identity { right: calc(var(--avatar-size) + 86px); }
		.description, .footer { left: 45%; }
		.footer { flex-wrap: wrap; gap: 7px; font-size: 12px; }
	}
	@media (max-width: 1150px) {
		.profile { display: flex; align-items: center; gap: 28px; width: calc(var(--avatar-size) + 62px); }
		.avatar { flex-shrink: 0; width: var(--avatar-size); }
		.social-links { flex-direction: column; flex-shrink: 0; justify-content: space-between; height: var(--avatar-size); gap: 0; margin-top: 0; }
	}
	@media (max-width: 760px) {
		/* Keep the current phone composition size; wider screens add space on the right. */
		.composition { --mobile-left-gutter: 28px; --mobile-profile-gap: 24px; --mobile-content-width: min(318px, calc(100vw - var(--mobile-left-gutter) - 28px)); --avatar-size: calc(var(--mobile-content-width) - var(--mobile-profile-gap) - 29px); display: flex; flex-direction: column; align-items: flex-start; gap: 0; width: var(--mobile-content-width); margin: 0 0 0 var(--mobile-left-gutter); min-height: 100svh; padding: 52px 0 28px; }
		.identity, .profile, .navigation, .description, .footer { position: static; }
		.identity { width: 100%; text-align: left; }
		h1 { font-size: calc(var(--mobile-content-width) / 7); }
		.identity p { margin-top: 10px; font-size: 30px; }
		.profile { width: 100%; gap: var(--mobile-profile-gap); margin-top: 38px; }
		.social-link { width: 29px; height: 29px; }
		.navigation { position: relative; inset: auto; margin: 55px 0 55px 18px; gap: 20px; }
		.navigation::after { left: -18px; width: 174px; border-width: 2px; bottom: -16px; height: 37px; }
		.menu-item { font-size: 32px; }
		.description { margin-top: auto; }
		.profession { font-size: 21px; }
		.interests { font-size: 14px; }
		.footer { width: 100%; flex-direction: column; align-items: flex-start; gap: 12px; margin-top: 36px; font-size: 11px; letter-spacing: .1px; }
		.registrations { flex-wrap: wrap; gap: 6px; }
	}
	@media (max-width: 360px) {
		.composition { --mobile-left-gutter: 20px; --mobile-profile-gap: 15px; }
	}
	@media (prefers-reduced-motion: reduce) {
		.menu-item, .arrow-shaft, .social-link { transition: none; }
	}
</style>
