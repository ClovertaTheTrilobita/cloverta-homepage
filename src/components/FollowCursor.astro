<div class="follow-cursor" aria-hidden="true">
	<span class="cursor-ring"></span>
	<span class="cursor-dot"></span>
</div>

<script>
	const cursor = document.querySelector<HTMLElement>('.follow-cursor');
	const mouseAvailable = window.matchMedia('(any-hover: hover) and (any-pointer: fine)');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
	const clickable = 'a[href], button:not(:disabled), input:not(:disabled):not([type="hidden"]), select:not(:disabled), textarea:not(:disabled), summary, [role="button"], [role="link"], [data-cursor="pointer"]';

	if (cursor) {
		const ring = cursor.querySelector<HTMLElement>('.cursor-ring')!;
		const dot = cursor.querySelector<HTMLElement>('.cursor-dot')!;
		let ringX = 0;
		let ringY = 0;
		let dotX = 0;
		let dotY = 0;
		let targetX = 0;
		let targetY = 0;
		let frame = 0;
		let lastTime = 0;
		let visible = false;
		const position = () => {
			ring.style.transform = `translate3d(${ringX}px, ${ringY}px, 0) translate(-50%, -50%)`;
			dot.style.transform = `translate3d(${dotX}px, ${dotY}px, 0) translate(-50%, -50%)`;
		};

		const render = (time: number) => {
			const elapsed = lastTime ? Math.min(time - lastTime, 64) : 16;
			lastTime = time;
			const ringFollow = reducedMotion.matches ? 1 : 1 - Math.exp(-elapsed / 35);
			const dotFollow = reducedMotion.matches ? 1 : 1 - Math.exp(-elapsed / 8);
			ringX += (targetX - ringX) * ringFollow;
			ringY += (targetY - ringY) * ringFollow;
			dotX += (targetX - dotX) * dotFollow;
			dotY += (targetY - dotY) * dotFollow;
			position();
			if (Math.max(Math.hypot(targetX - ringX, targetY - ringY), Math.hypot(targetX - dotX, targetY - dotY)) > 0.1) {
				frame = requestAnimationFrame(render);
			} else {
				frame = 0;
				lastTime = 0;
			}
		};

		const updateHover = (target: EventTarget | null) => {
			const control = target instanceof Element ? target.closest(clickable) : null;
			cursor.classList.toggle('is-hovering', !!control && control.getAttribute('aria-disabled') !== 'true');
		};

		const hide = () => {
			visible = false;
			cursor.classList.remove('is-visible', 'is-hovering');
			cancelAnimationFrame(frame);
			frame = 0;
			lastTime = 0;
		};

		window.addEventListener('pointermove', (event) => {
			if (event.pointerType !== 'mouse' || !mouseAvailable.matches) {
				hide();
				return;
			}
			targetX = event.clientX;
			targetY = event.clientY;
			if (!visible) {
				ringX = dotX = targetX;
				ringY = dotY = targetY;
				position();
				visible = true;
				cursor.classList.add('is-visible');
			}
			updateHover(event.target);
			if (!frame) frame = requestAnimationFrame(render);
		}, { passive: true });
		document.addEventListener('pointerover', (event) => {
			if (visible) updateHover(event.target);
		});
		document.documentElement.addEventListener('pointerleave', hide);
		window.addEventListener('blur', hide);
		window.addEventListener('pointerdown', (event) => {
			if (event.pointerType !== 'mouse') hide();
		});
		window.addEventListener('keydown', hide);
		document.addEventListener('visibilitychange', () => {
			if (document.hidden) hide();
		});
		mouseAvailable.addEventListener('change', hide);
	}
</script>

<style>
	.follow-cursor { position: fixed; top: 0; left: 0; width: 0; height: 0; z-index: 9999; pointer-events: none; opacity: 0; transition: opacity 140ms ease; }
	.follow-cursor.is-visible { opacity: 1; }
	.cursor-ring, .cursor-dot { position: absolute; top: 0; left: 0; border-radius: 50%; transform: translate(-50%, -50%); }
	.cursor-ring { width: 28px; height: 28px; border: 2px solid rgb(110 110 110 / 48%); transition: width 200ms ease, height 200ms ease, opacity 200ms ease; }
	.cursor-dot { width: 5px; height: 5px; background: rgb(65 65 65); opacity: .78; transition: width 200ms ease, height 200ms ease, opacity 200ms ease; }
	.is-hovering .cursor-ring { width: 56px; height: 56px; opacity: 0; }
	.is-hovering .cursor-dot { width: 56px; height: 56px; opacity: .24; }
	@media (prefers-reduced-motion: reduce) {
		.follow-cursor, .cursor-ring, .cursor-dot { transition: none; }
	}
</style>
