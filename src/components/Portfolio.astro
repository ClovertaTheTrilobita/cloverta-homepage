---
import Home from './Home.astro';
import About from './About.astro';
import Backgrounds from './Backgrounds.astro';

interface Props { initialView?: 'home' | 'about'; }
const { initialView = 'home' } = Astro.props;
---

<script is:inline>document.documentElement.classList.add('portfolio-js');</script>
<div class="portfolio" data-view={initialView}>
	<Backgrounds />
	<div class="home-view" inert={initialView === 'about'}><Home /></div>
	<div class="about-view" inert={initialView === 'home'}><About /></div>
</div>

<script>
	import '../scripts/portfolio';
</script>

<style is:global>
	.portfolio { position: relative; min-height: 100svh; isolation: isolate; }
	.portfolio.is-transitioning, .portfolio.is-preparing, .portfolio.is-copy-entering { overflow: clip; }
	/* Keep inactive views measurable while their animation positions are prepared. */
	.portfolio[data-view='home']:not(.is-transitioning) .about-view,
	.portfolio[data-view='about']:not(.is-transitioning) .home-view { position: absolute; left: 0; top: 0; width: 100%; visibility: hidden; pointer-events: none; }
	.portfolio:is(.is-preparing, .is-transitioning) .home-view { position: absolute; left: 0; top: 0; width: 100%; }
	.portfolio:is(.is-preparing, .is-transitioning) .about-view { position: relative; }
	.portfolio.is-transitioning .return-bounce { animation: none; }
	.portfolio.is-transitioning .about-copy { pointer-events: none; }
	.portfolio-js .about-copy:not(.is-ready) { opacity: 0; }
	.transition-title { position: fixed; z-index: 20; margin: 0; width: max-content; white-space: nowrap; font-family: var(--display-font); font-weight: 400; pointer-events: none; }
	.transition-chevron { position: fixed; z-index: 20; border-top-style: solid; border-right-style: solid; border-radius: 1px; pointer-events: none; }
</style>
