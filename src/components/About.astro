    }
    .return-bounce {
        display: grid;
        place-items: center;
        width: 100%;
        height: 100%;
        animation: return-bounce 2.8s ease-in-out infinite;
    }
    .return-chevron {
        display: block;
        width: 24px;
        height: 24px;
        border-top: 4px solid currentColor;
        border-right: 4px solid currentColor;
        border-radius: 1px;
        transform: translateY(7px) rotate(-45deg);
    }
    .about-return:hover {
        color: #252525;
    }
    .about-copy {
        margin-top: 38px;
        font:
            300 24px/1.45 "Josefin Slab",
            "Times New Roman",
            serif;
    }
    .about-copy p {
        margin: 0 0 12px;
    }
    .about-copy p:last-child {
        margin-bottom: 0;
    }
    .about-copy a {
        color: #00a6c4;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .about-copy a:hover {
