    }
    @media (max-width: 760px) {
        .about-page {
            width: auto;
            margin-inline: 28px;
            padding: 52px 0 40px;
        }
        .about-title {
            font-size: 32px;
        }
        .about-copy {
            margin-top: 30px;
            font-size: 21px;
            line-height: 1.5;
        }
        .about-copy p {
            margin-bottom: 14px;
        }
        .return-chevron {
            width: 21px;
            height: 21px;
            border-width: 3px;
        }
    }
    @media (max-width: 360px) {
