---
import FollowCursor from "../components/FollowCursor.astro";

// Optional stylesheet supplied by the font provider (HelloFont or Adobe Fonts).
const helloFontStylesheet = import.meta.env.PUBLIC_HELLOFONT_CSS_URL;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="ClovertaTheTrilobita · A.K.A 三叶 — Software Engineering. WEB / CODE / LINUX / NONSENSE."
		/>
		<meta name="theme-color" content="#ffffff" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
			rel="preload"
			href="/fonts/zcool-qingke-huangyou.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		{
			helloFontStylesheet && (
				<link rel="stylesheet" href={helloFontStylesheet} />
			)
		}
		<meta name="generator" content={Astro.generator} />
		<title>三叶草 -More About Me-</title>
	</head>
	<body><slot /><FollowCursor /></body>
</html>

<style is:global>
	@font-face {
		font-family: "ZCOOL QingKe HuangYou";
		src: url("/fonts/zcool-qingke-huangyou.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "Source Han Serif";
		src: url("/fonts/source-han-serif.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	@font-face {
		font-family: "HelloFont DianHei";
		src:
			local("字由点字典黑"), local("HelloFont ID DianHei"),
			local("IdeaFonts DianHei"), local("点字典黑 55J");
		font-display: swap;
	}
	@font-face {
		font-family: "Resource Han Rounded";
		src: url("/fonts/resource-han-rounded.woff2") format("woff2");
		font-weight: 400;
		font-style: normal;
		font-display: swap;
	}
	:root {
		font-family:
			"hellofont-id-dianhei", "HelloFont DianHei", Arial, "PingFang SC",
			sans-serif;
		color: #575757;
		background: #fff;
		font-synthesis: none;
		--display-font: "ZCOOL QingKe HuangYou", sans-serif;
	}
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		min-width: 320px;
		min-height: 100%;
	}
	button,
	a {
		-webkit-tap-highlight-color: transparent;
	}
	button {
		font: inherit;
	}
	a {
		color: inherit;
		text-decoration: none;
	}
	button:focus-visible,
	a:focus-visible {
		outline: 2px solid #777;
		outline-offset: 7px;
	}
	::selection {
		color: #fff;
		background: #777;
	}
</style>
